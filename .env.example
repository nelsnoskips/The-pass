# Studio backend. Copy to .env.local for development; set the same keys
# in the Netlify dashboard for production.

# Postgres. Neon's POOLED connection string in production — the pooled
# endpoint is what survives serverless, and the driver already disables
# prepared statements for pgbouncer.
DATABASE_URL=

# Transactional mail: the studio login link, and the notification when a
# client submits a review. Without it the app still runs and still saves
# everything; it just logs instead of sending.
RESEND_API_KEY=
MAIL_FROM="The Pass <hello@madisonfour.com>"

# Where review notifications go, and who may sign in to /studio.
# STUDIO_ALLOWED_EMAILS is a comma-separated allowlist.
STUDIO_EMAIL=nelson.schnebelen@gmail.com
STUDIO_ALLOWED_EMAILS=nelson.schnebelen@gmail.com

# Billing. The secret key is only ever read by scripts/invoice.mjs, which
# runs on your machine — it is not used by the site and must not be set as
# a Netlify variable. The portal URL is public and is set in Netlify: it
# is the link on the client billing page to Stripe's hosted portal.
STRIPE_SECRET_KEY=
STRIPE_CUSTOMER_PORTAL_URL=

# Overrides the hardcoded GA4 property if you ever move it.
NEXT_PUBLIC_GA_ID=

# Agents. The API key runs the model; the cron secret is what a scheduler
# must present to /api/agents/run. Without either, agents simply don't run.
ANTHROPIC_API_KEY=
AGENT_CRON_SECRET=

# SMS. Without these every text is a recorded dry run and nothing is sent.
# TWILIO_FROM is an E.164 number or a messaging service SID (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
